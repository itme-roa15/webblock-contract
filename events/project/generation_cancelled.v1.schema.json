{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webblock.invalid/contracts/events/project/generation_cancelled.v1.schema.json",
  "title": "Project: generation cancelled v1",
  "description": "DRAFT, proposed by project, waits for ai_codegen. Owner: project. Serves Project PR-16. The generation request passed its hard deadline and is failed (codegen_timeout), so AI Codegen may stop its work for it. Sent on exchange project.events with routing key generation_cancelled.v1. correlation_id equals generation_request_id. A completion that arrives later is ignored by Project. Not built in Project yet.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "message_id", "message_type", "occurred_at", "correlation_id", "project_id", "generation_request_id"],
  "properties": {
    "schema_version": { "const": 1 },
    "message_id": { "type": "string", "format": "uuid", "minLength": 36, "maxLength": 36, "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "not": {"enum": ["00000000-0000-0000-0000-000000000000"]} },
    "message_type": { "const": "project.generation_cancelled.v1" },
    "occurred_at": { "type": "string", "format": "date-time", "maxLength": 40 },
    "correlation_id": { "type": "string", "minLength": 36, "maxLength": 36, "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "project_id": { "type": "string", "format": "uuid", "minLength": 36, "maxLength": 36, "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "not": {"enum": ["00000000-0000-0000-0000-000000000000"]} },
    "generation_request_id": { "type": "string", "format": "uuid", "minLength": 36, "maxLength": 36, "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "not": {"enum": ["00000000-0000-0000-0000-000000000000"]} }
  }
}
