{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webblock.invalid/contracts/events/project/owner_status_changed.v1.schema.json",
  "title": "Project: owner status changed v1",
  "description": "ACCEPTED by project word for word (agent cd76ff0c, 10 November 2026; routing key owner_status_changed.v1 on project.events). Project sends it when the owner's account is suspended, made active again or deleted (account.user_status_changed.v1, account.user_deleted.v1), for each of the owner's websites that has a subdomain; a website without one is skipped. Owner: project. The owner of the project was suspended or made active again. status_version grows by one with each change, so a consumer ignores an older or equal version. subdomain is the site's DNS label.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "message_type",
    "occurred_at",
    "correlation_id",
    "project_id",
    "status",
    "status_version",
    "subdomain"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "message_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "enum": [
          "00000000-0000-0000-0000-000000000000"
        ]
      }
    },
    "message_type": {
      "const": "project.owner_status_changed.v1"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "project_id": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "enum": [
          "00000000-0000-0000-0000-000000000000"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended"
      ]
    },
    "status_version": {
      "type": "integer",
      "format": "int64",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "subdomain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
    }
  }
}
