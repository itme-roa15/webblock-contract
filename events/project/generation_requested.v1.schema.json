{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webblock.invalid/contracts/events/project/generation_requested.v1.schema.json",
  "title": "Project: generation requested v1",
  "description": "DRAFT, proposed by project, waits for ai_codegen. Owner: project. Serves Project FR-27, FR-27.1, PR-16. Payment admitted the generation request and it is now generating; AI Codegen fetches the frozen input from Project. Sent on exchange project.events with routing key generation_requested.v1. correlation_id equals generation_request_id. captured_input_hash is the lowercase hex SHA-256 of the RFC 8785 (JCS) form of the captured input. This is the body Project sends today (GenerationRequested.java); every field is always present and never null.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "message_id", "message_type", "occurred_at", "correlation_id", "project_id", "generation_request_id", "captured_input_hash"],
  "properties": {
    "schema_version": { "const": 1 },
    "message_id": { "type": "string", "format": "uuid", "minLength": 36, "maxLength": 36, "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "not": {"enum": ["00000000-0000-0000-0000-000000000000"]} },
    "message_type": { "const": "project.generation_requested.v1" },
    "occurred_at": { "type": "string", "format": "date-time", "maxLength": 40 },
    "correlation_id": { "type": "string", "minLength": 36, "maxLength": 36, "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "project_id": { "type": "string", "format": "uuid", "minLength": 36, "maxLength": 36, "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "not": {"enum": ["00000000-0000-0000-0000-000000000000"]} },
    "generation_request_id": { "type": "string", "format": "uuid", "minLength": 36, "maxLength": 36, "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "not": {"enum": ["00000000-0000-0000-0000-000000000000"]} },
    "captured_input_hash": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" }
  }
}
