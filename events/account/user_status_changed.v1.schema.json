{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webblock.invalid/contracts/events/account/user_status_changed.v1.schema.json",
  "title": "Account: user status changed v1",
  "description": "DRAFT, proposed by project, waits for account. Owner: account. Serves Project PR-21. A user was suspended or made active again. Fields from Notion \"1 · Account\" (section Event, table account.user_status_changes). event_key is the user_status_change_id. status_version is the user's version after this change and grows by one with each change, so a consumer drops an event whose version is at or below the one it holds. reason_code is set exactly when to_status is suspended. changed_by is the admin's Keycloak subject, null when the system made the change. The admin's note is never sent. Open point: a user event is about no project, so this body has no project_id, while envelope.v1 requires it (Notion \"Web Block architecture\" 4.1 says project_id is sent when there is one). Sent on exchange account.events with routing key user_status_changed.v1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "message_id", "message_type", "occurred_at", "correlation_id", "event_key", "user_id", "status_version", "from_status", "to_status", "reason_code", "changed_by", "changed_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "message_id": { "type": "string", "format": "uuid", "minLength": 36, "maxLength": 36, "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "not": {"enum": ["00000000-0000-0000-0000-000000000000"]} },
    "message_type": { "const": "account.user_status_changed.v1" },
    "occurred_at": { "type": "string", "format": "date-time", "maxLength": 40 },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "event_key": { "type": "string", "format": "uuid", "minLength": 36, "maxLength": 36, "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "not": {"enum": ["00000000-0000-0000-0000-000000000000"]} },
    "user_id": { "type": "string", "format": "uuid", "minLength": 36, "maxLength": 36, "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "not": {"enum": ["00000000-0000-0000-0000-000000000000"]} },
    "status_version": { "type": "integer", "format": "int64", "minimum": 1, "maximum": 9007199254740991 },
    "from_status": { "type": "string", "enum": ["active", "suspended"] },
    "to_status": { "type": "string", "enum": ["active", "suspended"] },
    "reason_code": { "type": ["string", "null"], "enum": ["abuse", "fraud", "owner_request", "other", null] },
    "changed_by": { "type": ["string", "null"], "minLength": 1, "maxLength": 255 },
    "changed_at": { "type": "string", "format": "date-time", "maxLength": 40 }
  },
  "if": { "properties": { "to_status": { "const": "suspended" } } },
  "then": { "properties": { "from_status": { "const": "active" }, "reason_code": { "type": "string" } } },
  "else": { "properties": { "from_status": { "const": "suspended" }, "reason_code": { "type": "null" } } }
}
